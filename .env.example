# Optional. Copy to .env, choose a provider and a model available to you.
# Without configuration, use an external AI through cli.py or create questions yourself.
LERNRAUM_AI_PROVIDER=openai
LERNRAUM_AI_MODEL=
OPENAI_API_KEY=

# Alternative: run Ollama locally and set the provider to ollama.
# LERNRAUM_AI_PROVIDER=ollama
# LERNRAUM_AI_MODEL=YOUR_INSTALLED_MODEL
# LERNRAUM_OLLAMA_URL=http://127.0.0.1:11434
